# Virtual robot hardware for the firmware simulator. Every pin and number here
# is a PLACEHOLDER: replace them with your real wiring and bench measurements.
# Chassis frame: x forward, y to the left, metres. Pins: D0-D13, A0-A7, LEDR...
track_width 0.10          # wheel centre to wheel centre
wheel_radius 0.020
body_radius 0.07          # collision circle (handout: fits a 15 cm cylinder)
motor_max_speed 30        # wheel rad/s at full duty and nominal voltage
motor_time_constant 0.08  # s, first-order speed response
motor_deadband 0.06       # |duty| below this does not turn the wheel
nominal_voltage 7.4       # wheel speed scales with battery / nominal
# Motor drivers: pwm_dir pwm= dir= | in_in in1= in2= | en_in_in en= in1= in2=
# Add "invert" if forward duty spins that wheel backwards.
motor left  pwm_dir pwm=D5 dir=D4
motor right pwm_dir pwm=D6 dir=D7
# Quadrature encoders: ppr = pulses per WHEEL revolution on channel A.
encoder left  a=D2 b=D3 ppr=360
encoder right a=D8 b=D9 ppr=360
# Reflective line sensors: analog (on=V over tape, off=V over floor) or
# digital (add "digital", on_level=0/1).
# Left/right pair straddles the 5 cm tape (handout); centre sits on it.
line_sensor left   pin=A0 x=0.06 y=0.035
line_sensor centre pin=A1 x=0.06 y=0
line_sensor right  pin=A2 x=0.06 y=-0.035
# Distance sensors: ultrasonic (HC-SR04 style, pulseIn) or ir_distance (analog).
ultrasonic front trig=D10 echo=D11 x=0.07 y=0 yaw_deg=0 max=2.0
# Battery through a divider into an analog pin (V_batt = divider * V_pin).
battery pin=A7 divider=3.0 volts=8.0 drain_per_min=0
# Onboard IMU gyro error, deg/s.
gyro bias=0.2 noise=0.05
