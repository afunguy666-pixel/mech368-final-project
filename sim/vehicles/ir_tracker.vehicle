# Virtual robot for sim/examples/line_tracker, built from the course parts:
# DRV8833 driver, 6 V 100:1 micro metal gearmotors with encoders,
# LTE-4206 / LTR-4206 IR pairs (line array read as analog voltages; obstacle
# pair through an LM393 comparator). Every pin and number is a PLACEHOLDER:
# replace them with your wiring and bench measurements.
# Chassis frame: x forward, y to the left, metres.
track_width 0.11          # wheel centre to wheel centre
wheel_radius 0.016        # 32 mm wheels (assumed)
body_radius 0.07          # handout: fits a 15 cm cylinder
motor_max_speed 30        # wheel rad/s at full duty (~290 rpm loaded, assumed)
motor_time_constant 0.08
motor_deadband 0.08
nominal_voltage 7.2
# DRV8833 (IN/IN, PWM on the inputs), shared nSLEEP on D8.
motor left  in_in in1=D4 in2=D5 sleep=D8
motor right in_in in1=D6 in2=D7 sleep=D8
# Magnetic encoder: 12 counts/rev of the motor shaft on both edges of both
# channels = 3 pulses on channel A per motor revolution, x100 gearbox.
encoder left  a=D2 b=D3 ppr=300
encoder right a=D9 b=D10 ppr=300
# Line array: 4 phototransistors, 3 cm apart, 6 cm ahead of the axle. Over the
# 5 cm tape the two inner sensors are black and the outer two are white.
# Common-emitter wiring with a pull-up to 3.3 V: black (less reflected IR)
# reads high. NEVER pull these up to 5 V: Nano 33 BLE pins are 3.3 V only.
line_sensor r_out pin=A0 x=0.06 y=-0.045 on=2.9 off=0.5 spot=0.004
line_sensor r_in  pin=A1 x=0.06 y=-0.015 on=2.9 off=0.5 spot=0.004
line_sensor l_in  pin=A2 x=0.06 y=0.015  on=2.9 off=0.5 spot=0.004
line_sensor l_out pin=A3 x=0.06 y=0.045  on=2.9 off=0.5 spot=0.004
# Obstacle IR pairs at the front corners, toed out 10 degrees, through an
# LM393 (open collector, pull-up to 3.3 V): output LOW when an object is
# within range.
ir_proximity front_left  pin=D12 x=0.065 y=0.03  yaw_deg=10  range=0.08 fov_deg=20 on_level=0
ir_proximity front_right pin=D11 x=0.065 y=-0.03 yaw_deg=-10 range=0.08 fov_deg=20 on_level=0
battery pin=A7 divider=3.0 volts=7.2 drain_per_min=0
gyro bias=0.3 noise=0.05
temperature tau=2.0 noise=0.05 offset=0
