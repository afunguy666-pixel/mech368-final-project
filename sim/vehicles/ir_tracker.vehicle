# Virtual robot for sim/examples/line_tracker. Geometry from the team's
# SolidWorks assembly (2026-11-26): chassis disc + front sensor frame, 65 mm
# wheels at the rear, ball caster at the front, sensors on the front frame.
# Motor, sensor and battery numbers are still PLACEHOLDERS: replace them with
# bench measurements.
# Chassis frame: x forward, y to the left, metres, origin at the wheel axle
# midpoint (CAD chassis origin is 15.25 mm ahead of the axle).
track_width 0.092         # wheel centres +-46 mm (CAD)
wheel_radius 0.0325       # 65 mm wheels (CAD)
body_radius 0.075         # 150 mm handout cylinder (CAD envelope 148 mm) ...
body_offset 0.01525       # ... centred on the CAD chassis origin, 15.25 mm ahead of the axle
motor_max_speed 30        # wheel rad/s at full duty (assumed, ~290 rpm loaded)
motor_time_constant 0.08
motor_deadband 0.08
nominal_voltage 7.2
# DRV8833 (IN/IN, PWM on the inputs), shared nSLEEP on D8.
motor left  in_in in1=D4 in2=D5 sleep=D8
motor right in_in in1=D6 in2=D7 sleep=D8
# Magnetic encoder: 12 counts/rev of the motor shaft on both edges of both
# channels = 3 pulses on channel A per motor revolution, x100 gearbox.
encoder left  a=D2 b=D3 ppr=300
encoder right a=D9 b=D10 ppr=300
# Line array (CAD sketch): 4 sensors at y = -30, -10, +10, +30 mm on the
# front frame, 2 mm behind its front edge = 78.25 mm ahead of the axle.
# Common-emitter wiring with a pull-up to 3.3 V: black (less reflected IR)
# reads high. NEVER pull these up to 5 V: Nano 33 BLE pins are 3.3 V only.
line_sensor r_out pin=A0 x=0.07825 y=-0.030 on=2.9 off=0.5 spot=0.004
line_sensor r_in  pin=A1 x=0.07825 y=-0.010 on=2.9 off=0.5 spot=0.004
line_sensor l_in  pin=A2 x=0.07825 y=0.010  on=2.9 off=0.5 spot=0.004
line_sensor l_out pin=A3 x=0.07825 y=0.030  on=2.9 off=0.5 spot=0.004
# Obstacle IR pairs (CAD sketch): y = +-20 mm on the same line, toed out 10
# degrees, through an LM393 (pull-up to 3.3 V): output LOW within range.
ir_proximity front_left  pin=D12 x=0.07825 y=0.020  yaw_deg=10  range=0.08 fov_deg=20 on_level=0
ir_proximity front_right pin=D11 x=0.07825 y=-0.020 yaw_deg=-10 range=0.08 fov_deg=20 on_level=0
battery pin=A7 divider=3.0 volts=7.2 drain_per_min=0
gyro bias=0.3 noise=0.05
temperature tau=2.0 noise=0.05 offset=0
